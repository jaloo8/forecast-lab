# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
# NOTE: .python-version is deliberately NOT ignored. It pins the interpreter
# uv resolves on every machine (dev, CI, the Windows cron host). Ignoring it
# let three environments drift to 3.12/3.13/3.14, so a green CI run no longer
# proved production worked. Keep it tracked.

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
coverage.json
*.cover
.hypothesis/

# ---- Type checkers / linters ----
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ---- Notebooks ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
.cursor/
.aider*

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets / credentials ----
# Never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/*
!secrets/.gitkeep
credentials/
api_keys.txt
kalshi_private_key*
*.credentials.json
# age private keys (SOPS recipients). The `keys.txt` file convention
# matches the default sops/age path; defensive in case a copy lands in
# the repo by mistake. The encrypted secrets.enc.yaml file IS committed
# -- only the private decryption key must never reach git.
keys.txt
*.age
age-keys.txt

# ---- Data ----
# Ingested market data, forecasts, etc. — big, frequently regenerated, often licensed
data/
datasets/
*.parquet
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite-journal
*.db
*.db-journal
*.csv
*.tsv
*.feather
*.arrow
# Exception: small fixture files for tests should be checked in
!tests/fixtures/*.csv
!tests/fixtures/*.parquet
!tests/fixtures/*.json
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.json

# ---- Model artifacts ----
# Pickled trained models are reproducible from training scripts; don't commit
# binaries. The manifest.json sibling IS committed so reviews can see the
# fit summary (training window, sample count, OOS Brier, reliability bins).
models/*.pkl
models/*.joblib
models/*.pt
models/*.bin
models/*.gguf
*.safetensors
checkpoints/
!models/.gitkeep
!models/manifest.json

# ---- Logs ----
logs/
*.log
*.log.*
.logrotate.state

# ---- Trade and signal records (private) ----
trade_log/
signals/output/
backtest_results/
portfolio_snapshots/
costs/llm.csv

# ---- Observability / agent state ----
langfuse/
.prefect/
prefect.db
agent_state/
agent_memory/

# ---- Claude Code / AI tooling scratch ----
# Local scratch/settings stay ignored, but agent definitions are part of
# the repo (CLAUDE.md §0) so every clone gets the same dev agent.
.claude/*
!.claude/agents/
.aider.chat.history.*
.aider.input.history
.aider.tags.cache.v*

# ---- Weather data caches ----
grib/
*.grib
*.grib2
*.nc

# ---- Large research PDFs (keep Markdown, skip binaries) ----
docs/archive/*.pdf

# ---- Backup / scratch ----
tmp/
scratch/
*.bak
*.tmp

# ---- mutmut (mutation testing) working dir + cache ----
mutants/
.mutmut-cache
