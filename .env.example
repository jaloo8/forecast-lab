# Copy to .env and fill in. Never commit the real .env file.
#
# OR (preferred): run `make bootstrap-secrets` to auto-populate from the
# encrypted secrets store (SOPS + age). See docs/SECRETS.md for one-time
# setup. The bootstrap script copies this file to .env on first run and
# then overwrites only the secret KEYs from secrets.enc.yaml -- your
# tunables (LOG_LEVEL, KQ_*, AGENT_*) stay where you put them.

# ---- Kalshi (https://kalshi.com/docs/api) ----
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem
KALSHI_ENV=demo                        # demo | prod

# ---- Weather / NOAA (free tiers; only Open-Meteo commercial tier needs a key) ----
OPEN_METEO_API_KEY=                    # optional, unset for free tier
NOAA_USER_AGENT=forecast-lab (your-email@example.com)

# ---- Odds / sports ----
ODDS_API_KEY=                          # the-odds-api.com; optional
BALLDONTLIE_API_KEY=                   # free tier works without

# ---- LLM providers (only used in v2 agent; unused in v1) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ---- Storage ----
# Leave DATABASE_URL unset (commented) to use the built-in default:
# <repo-root>/data/forecast_lab.duckdb — anchored to the repo, so `kq`
# works from any working directory. If you DO set it, use an ABSOLUTE
# path: a relative `duckdb:///data/...` resolves against the CURRENT
# WORKING DIRECTORY, and a cron job or `kq` run from outside the repo
# would silently create (and read) a second empty database.
#DATABASE_URL=duckdb:////absolute/path/to/forecast_lab.duckdb
#SQLITE_OPS_URL=sqlite:////absolute/path/to/ops.sqlite

# ---- Runtime ----
LOG_LEVEL=INFO
TZ=UTC

# ---- Trading safety gates (DO NOT CHANGE WITHOUT READING CLAUDE.md §5) ----
KQ_LIVE=false                          # must be "true" to allow live endpoint
KQ_MAX_POSITION_USD=200                # hard cap per open position
KQ_MAX_DAILY_LOSS_PCT=3                # auto-halt above this %
KQ_KELLY_FRACTION=0.15                 # fractional-Kelly cap

# ---- v2 agent budget gates (unused in v1) ----
AGENT_DAILY_USD_CAP=10.00
AGENT_PER_RUN_USD_CAP=2.00
AGENT_PER_RUN_MAX_ITER=20
AGENT_PER_RUN_WALL_CLOCK_S=1800

# ---- Notifications (optional) ----
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
NTFY_TOPIC=
# Status report every 8 hours at 00/08/16 local (scripts/status-report.ps1):
# always pushes to NTFY_TOPIC. To ALSO get it as real email, set the address
# plus SMTP creds (Yahoo: smtp.mail.yahoo.com, port 587, an APP password —
# not your login password). Email is skipped silently while any are empty.
KQ_REPORT_EMAIL=
KQ_SMTP_HOST=
KQ_SMTP_PORT=587
KQ_SMTP_USER=
KQ_SMTP_PASS=
